# Идентификатор таблицы из её адреса
SHEET_ID=

# Ключ сервисного аккаунта Google: сырой JSON целиком либо он же в base64
GOOGLE_SERVICE_ACCOUNT_JSON=

# Wildberries: разные токены под разные категории доступа
WB_STATS_KEY=
WB_MARKET_KEY=
# Остатки FBO переехали в аналитику: нужен токен с категорией «Аналитика».
# Если пусто — берётся WB_STATS_KEY, но он обычно такой категории не имеет.
WB_ANALYTICS_KEY=

# Ozon
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс Маркет: FBY и FBS — разные кампании, номера не совпадают
YM_API_KEY=
YM_CAMPAIGN_FBS=
YM_CAMPAIGN_FBY=

# Ламода, Seller Partner API v2: ключи из кабинета («Настройки аккаунта» → «API ключи»)
LAMODA_CLIENT_ID=
LAMODA_CLIENT_SECRET=
# Seller Shop ID: «Настройки аккаунта» → «Общая информация». Пусто — берётся из токена, если он его несёт
LAMODA_SELLER_ID=

# М.Видео (omninet): ключ API поставщика из кабинета продавца
MVIDEO_API_KEY=

# Часовой пояс сервиса, по умолчанию Europe/Moscow.
# Маркетплейсы отдают время московским и без смещения.
TZ=
